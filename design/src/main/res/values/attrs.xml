<?xml version="1.0" encoding="utf-8"?>
<resources>
    <attr name="fullScreenDialogTheme" format="reference" />

    <attr name="colorClashStopped" format="color" />
    <attr name="colorControlDisabled" format="color" />
    <attr name="colorLogo" format="color" />

    <attr name="enabled" format="boolean" />
    <attr name="text" format="string" />
    <attr name="subtext" format="string" />
    <attr name="icon" format="reference" />
    <attr name="color" format="color" />
    <attr name="placeholder" format="string" />
    <attr name="title" format="string" />

    <declare-styleable name="LargeActionCard">
        <attr name="text" />
        <attr name="subtext" />
        <attr name="icon" />
    </declare-styleable>

    <declare-styleable name="LargeActionLabel">
        <attr name="text" />
        <attr name="subtext" />
        <attr name="icon" />
    </declare-styleable>

    <declare-styleable name="ActionLabel">
        <attr name="enabled" />
        <attr name="text" />
        <attr name="subtext" />
        <attr name="icon" />
    </declare-styleable>

    <declare-styleable name="ActionTextField">
        <attr name="enabled" />
        <attr name="icon" />
        <attr name="title" />
        <attr name="text" />
        <attr name="placeholder" />
    </declare-styleable>

    <declare-styleable name="Clickable">
        <attr name="android:focusable" />
        <attr name="android:clickable" />
        <attr name="android:background" />
        <attr name="android:foreground" />
    </declare-styleable>

    <!-- EasyClash UI tokens -->
    <attr name="ui_surface" format="color" />
    <attr name="ui_surface_container" format="color" />
    <attr name="ui_surface_container_high" format="color" />
    <attr name="ui_on_surface" format="color" />
    <attr name="ui_on_surface_variant" format="color" />
    <attr name="ui_outline" format="color" />
    <attr name="ui_outline_variant" format="color" />
    <attr name="ui_scrim" format="color" />
    <attr name="ui_primary" format="color" />
    <attr name="ui_on_primary" format="color" />
    <attr name="ui_primary_container" format="color" />
    <attr name="ui_on_primary_container" format="color" />
    <attr name="ui_status_connected" format="color" />
    <attr name="ui_status_connected_container" format="color" />
    <attr name="ui_status_connecting" format="color" />
    <attr name="ui_status_connecting_container" format="color" />
    <attr name="ui_status_degraded" format="color" />
    <attr name="ui_status_degraded_container" format="color" />
    <attr name="ui_status_error" format="color" />
    <attr name="ui_status_error_container" format="color" />
    <attr name="ui_status_stopped" format="color" />
    <attr name="ui_control_disabled" format="color" />
</resources>
