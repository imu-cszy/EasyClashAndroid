<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <variable
            name="self"
            type="com.github.kr328.clash.design.ProfilesDesign" />

        <import type="android.view.View" />
    </data>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="@{self.surface.insets.start}"
        android:paddingEnd="@{self.surface.insets.end}">

        <LinearLayout
            android:id="@+id/empty_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="40dp"
            android:paddingEnd="40dp"
            android:paddingBottom="96dp"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="132dp"
                android:layout_height="132dp">

                <View
                    android:layout_width="132dp"
                    android:layout_height="132dp"
                    android:background="@drawable/bg_empty_blob" />

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/empty_profiles_title"
                    android:src="@drawable/ic_nav_profiles"
                    app:tint="?attr/ui_primary" />

                <View
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_dot" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="12dp"
                    android:layout_marginBottom="18dp"
                    android:background="@drawable/bg_dot" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ui_space_24"
                android:text="@string/empty_profiles_title"
                android:textColor="?attr/ui_on_surface"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ui_space_8"
                android:gravity="center"
                android:text="@string/empty_profiles_desc"
                android:textColor="?attr/ui_on_surface_variant"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ui_space_24"
                android:background="@drawable/bg_nav_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:onClick="@{() -> self.requestCreate()}"
                android:orientation="horizontal"
                android:paddingStart="@dimen/ui_space_24"
                android:paddingTop="13dp"
                android:paddingEnd="@dimen/ui_space_24"
                android:paddingBottom="13dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@string/empty_profiles_action"
                    android:src="@drawable/ic_outline_add"
                    app:tint="?attr/ui_on_surface" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ui_space_8"
                    android:text="@string/empty_profiles_action"
                    android:textColor="?attr/ui_on_surface"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <include
            android:id="@+id/main_list"
            android:layout_marginBottom="88dp"
            layout="@layout/common_recycler_list"
            app:insets="@{self.surface.insets}" />

        <com.github.kr328.clash.design.view.ActivityBarLayout
            android:id="@+id/activity_bar_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@{self.surface.insets.top}">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingEnd="@dimen/item_tailing_margin">

                <include
                    layout="@layout/common_activity_bar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_toStartOf="@id/update_layout" />

                <LinearLayout
                    android:id="@+id/update_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_toStartOf="@id/add_view"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/import_view"
                        android:layout_width="@dimen/item_tailing_component_size"
                        android:layout_height="@dimen/item_tailing_component_size"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="@dimen/item_tailing_margin"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="@string/bundle_import"
                        android:focusable="true"
                        android:onClick="@{() -> self.requestImportBundle()}"
                        android:padding="@dimen/toolbar_image_action_padding"
                        android:src="@drawable/ic_outline_cloud_download" />

                    <ImageView
                        android:id="@+id/update_view"
                        android:layout_width="@dimen/item_tailing_component_size"
                        android:layout_height="@dimen/item_tailing_component_size"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="@dimen/item_tailing_margin"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="@string/_new"
                        android:focusable="true"
                        android:onClick="@{() -> self.requestUpdateAll()}"
                        android:padding="@dimen/toolbar_image_action_padding"
                        android:src="@drawable/ic_outline_sync"
                        android:visibility="gone" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/add_view"
                    android:layout_width="@dimen/item_tailing_component_size"
                    android:layout_height="@dimen/item_tailing_component_size"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginStart="@dimen/item_tailing_margin"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="@string/_new"
                    android:focusable="true"
                    android:onClick="@{() -> self.requestCreate()}"
                    android:padding="@dimen/toolbar_image_action_padding"
                    android:src="@drawable/ic_outline_add" />

            </RelativeLayout>
        </com.github.kr328.clash.design.view.ActivityBarLayout>

        <com.github.kr328.clash.design.view.BottomNavBar
            android:id="@+id/bottom_nav"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ui_nav_height"
            android:layout_gravity="bottom"
            android:layout_marginHorizontal="@dimen/ui_space_16"
            android:layout_marginBottom="@dimen/ui_space_12"
            android:background="@drawable/bg_nav_pill"
            android:elevation="8dp" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>