<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.FrameLayout">

    <!-- 选中态胶囊：由 BottomNavBar 定位与动画 -->
    <View
        android:id="@+id/nav_pill"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:background="@drawable/bg_nav_item_pill" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <LinearLayout
            android:id="@+id/nav_item_dashboard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/nav_icon_dashboard"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/nav_dashboard"
                android:src="@drawable/ic_nav_dashboard" />

            <TextView
                android:id="@+id/nav_label_dashboard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/nav_dashboard"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_item_profiles"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/nav_icon_profiles"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/nav_profiles"
                android:src="@drawable/ic_nav_profiles" />

            <TextView
                android:id="@+id/nav_label_profiles"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/nav_profiles"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_item_tools"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/nav_icon_tools"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/nav_tools"
                android:src="@drawable/ic_nav_tools" />

            <TextView
                android:id="@+id/nav_label_tools"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/nav_tools"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</merge>
